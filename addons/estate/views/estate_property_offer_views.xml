<odoo>
    <!-- Action -->
    <record id="estate_property_offer_action" model="ir.actions.act_window">
        <field name="name">Penawaran Properti</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Tree/List -->
    <record id="estate_property_offer_view_tree" model="ir.ui.view">
        <field name="name">estate.property.offer.tree</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <tree string="Penawaran"
                editable="bottom"
                decoration-danger="status == 'refused'"
                decoration-success="status == 'accepted'">
                <field name="price" />
                <field name="partner_id" />
                <field name="validity" />
                <field name="date_deadline" />
                <button name="action_accept" type="object" title="Terima" icon="fa-check"
                    invisible="status" />
                <button name="action_refuse" type="object" title="Tolak" icon="fa-times"
                    invisible="status" />
                <field name="status" column_invisible="1" />
            </tree>
        </field>
    </record>

    <!-- Form -->
    <record id="estate_property_offer_view_form" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="price" />
                        <field name="partner_id" />
                        <field name="validity" />
                        <field name="date_deadline" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>