<odoo>
    <!-- Action -->
    <record id="estate_property_tags_action" model="ir.actions.act_window">
        <field name="name">Label Properti</field>
        <field name="res_model">estate.property.tags</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Search & Filter -->
    <record id="estate_property_tags_view_search_filter" model="ir.ui.view">
        <field name="name">estate.property.tags.search.filter</field>
        <field name="model">estate.property.tags</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
            </search>
        </field>
    </record>

    <record id="estate_property_tags_view_tree" model="ir.ui.view">
        <field name="name">estate.property.tags.tree</field>
        <field name="model">estate.property.tags</field>
        <field name="arch" type="xml">
            <tree string="Label Properti" editable="bottom">
                <field name="name" />
                <field name="color" widget="color_picker" />
            </tree>
        </field>
    </record>

    <record id="estate_property_tags_view_form" model="ir.ui.view">
        <field name="name">estate.property.tags.form</field>
        <field name="model">estate.property.tags</field>
        <field name="arch" type="xml">
            <form string="Label Properti">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="color" widget="color_picker" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>