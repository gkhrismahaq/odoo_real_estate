<odoo>
    <!-- Action -->
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Daftar Properti</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_available': 1}</field>
    </record>

    <!-- Search & Filter -->
    <record id="estate_property_view_search_filter" model="ir.ui.view">
        <field name="name">estate.property.search.filter</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="property_type_id" />
                <field name="postcode" />
                <field name="expected_price" />
                <field name="bedrooms" />
                <field name="living_area" filter_domain="[('living_area', '>=', self)]" />
                <field name="facades" />
                <filter name="available" string="Tersedia"
                    domain="[('status', 'in', ['new', 'offer_received'])]" />
                <filter name="group_by_postcode" string="Grup by Kode Pos"
                    context="{'group_by':'postcode'}" />
            </search>
        </field>
    </record>

    <!-- Tree/List -->
    <record id="estate_property_view_tree" model="ir.ui.view">
        <field name="name">estate.property.tree</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <tree string="Properti"
                decoration-success="status in ('offer_received', 'offer_accepted')"
                decoration-bf="status == 'offer_accepted'"
                decoration-muted="status == 'sold'">
                <field name="name" />
                <field name="property_type_id" />
                <field name="postcode" />
                <field name="bedrooms" />
                <field name="living_area" />
                <field name="expected_price" />
                <field name="selling_price" />
                <field name="date_availability" />
                <field name="status" />
            </tree>
        </field>
    </record>

    <!-- Form -->
    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Properti">
                <header>
                    <button name="action_sold" type="object" string="Terjual"
                        invisible="status in ('sold', 'canceled')" />
                    <button name="action_cancel" type="object" string="Batalkan"
                        invisible="status in ('sold', 'canceled')" />
                    <field name="status" widget="statusbar"
                        statusbar_visible="new,offer_received,offer_accepted,sold" />
                </header>
                <sheet>
                    <field name="active" invisible="1" />
                    <!-- Ribbon Arsip -->
                    <widget name="web_ribbon" title="Diarsipkan" bg_color="bg-warning"
                        invisible="active" />
                    <!-- Ribbon Terjual -->
                    <widget name="web_ribbon" title="Terjual" bg_color="bg-success"
                        invisible="status != 'sold'" />
                    <!-- Ribbon Dibatalkan -->
                    <widget name="web_ribbon" title="Dibatalkan" bg_color="bg-danger"
                        invisible="status != 'canceled'" />
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nama Properti" />
                        </h1>
                    </div>
                    <field name="tags_ids" widget="many2many_tags"
                        options="{'color_field': 'color'}" class="pb-3" />
                    <group>
                        <group>
                            <field name="property_type_id"
                                options="{'no_create': True, 'no_edit': True}" />
                            <field name="date_availability" />
                            <field name="status" readonly="1" />
                        </group>
                        <group>
                            <field name="expected_price" />
                            <field name="best_price" />
                            <field name="selling_price" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Deskripsi">
                            <group>
                                <group>
                                    <field name="postcode" />
                                    <field name="bedrooms" />
                                    <field name="facades" />
                                    <field name="garage" widget="boolean_toggle" />
                                    <field name="active" widget="boolean_toggle" />
                                </group>
                                <group>
                                    <field name="garden" />
                                    <field name="garden_orientation" widget="radio"
                                        invisible="not garden" />
                                    <label for="garden_area" />
                                    <div class="o_row">
                                        <field name="garden_area" />
                                        <span> m²</span>
                                    </div>
                                    <label for="living_area" />
                                    <div class="o_row">
                                        <field name="living_area" />
                                        <span> m²</span>
                                    </div>
                                    <label for="total_area" />
                                    <div class="o_row">
                                        <field name="total_area" />
                                        <span>m²</span>
                                    </div>
                                </group>
                            </group>
                            <separator string="Keterangan Lengkap" />
                            <field name="description" placeholder="Tulis detail properti di sini..." />
                        </page>
                        <page string="Penawaran">
                            <field name="offer_ids"
                                readonly="status in ('offer_accepted', 'sold', 'canceled')" />
                        </page>
                        <page string="Info Lainnya">
                            <group>
                                <field name="salesperson_id" />
                                <field name="buyer_id" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>