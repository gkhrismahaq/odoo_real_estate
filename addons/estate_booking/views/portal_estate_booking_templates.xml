<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. Breadcrumbs Inherit: Navigasi Hierarkis Portal Pelanggan -->
    <template id="portal_my_home_menu_booking" name="Portal layout : booking menu entries" inherit_id="portal.portal_breadcrumbs" priority="30">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'booking' or booking" t-attf-class="breadcrumb-item #{'active ' if not booking else ''}">
                <a t-if="booking" t-attf-href="/my/bookings">Reservasi Properti</a>
                <t t-else="">Reservasi Properti</t>
            </li>
            <li t-if="booking" class="breadcrumb-item active">
                <t t-esc="booking.name"/>
            </li>
        </xpath>
    </template>

    <!-- 2. Portal Home Entry: Kartu Reservasi Properti pada /my/home -->
    <template id="portal_my_home_estate_booking" name="Portal My Home : Booking Entries" inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Reservasi Properti</t>
                <t t-set="url" t-value="'/my/bookings'"/>
                <t t-set="placeholder_count" t-value="'booking_count'"/>
                <t t-set="count" t-value="booking_count"/>
            </t>
        </xpath>
    </template>

    <!-- 3. Portal Bookings List View: Daftar Riwayat Reservasi Klien -->
    <template id="portal_my_bookings" name="Daftar Reservasi Properti Saya">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Reservasi Properti</t>
            </t>

            <t t-if="not bookings">
                <div class="alert alert-info mt-4" role="alert">
                    <i class="fa fa-info-circle me-1"/>
                    Anda belum memiliki dokumen pemesanan properti yang tercatat.
                </div>
            </t>

            <t t-if="bookings">
                <div class="card border-0 shadow-sm rounded-3 mt-3 overflow-hidden">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-uppercase small text-muted">
                                <tr>
                                    <th class="ps-3">Nomor Referensi</th>
                                    <th>Unit Properti</th>
                                    <th>Tanggal Pemesanan</th>
                                    <th class="text-end">Uang Tanda Jadi</th>
                                    <th class="text-end">Sisa Kewajiban</th>
                                    <th class="text-center pe-3">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="bookings" t-as="b">
                                    <tr>
                                        <td class="ps-3 py-3">
                                            <a t-attf-href="/my/bookings/#{b.id}" class="fw-bold text-decoration-none text-primary">
                                                <t t-esc="b.name"/>
                                            </a>
                                        </td>
                                        <td>
                                            <span class="fw-semibold text-dark"><t t-esc="b.property_id.name"/></span>
                                            <span t-if="b.property_id.property_type_id" class="badge rounded-pill bg-light text-dark border ms-1 small">
                                                <t t-esc="b.property_id.property_type_id.name"/>
                                            </span>
                                        </td>
                                        <td class="text-muted">
                                            <span t-field="b.booking_date" t-options='{"widget": "date"}'/>
                                        </td>
                                        <td class="text-end fw-semibold">
                                            <span t-field="b.booking_fee_paid" t-options='{"widget": "monetary", "display_currency": b.currency_id}'/>
                                        </td>
                                        <td class="text-end fw-semibold">
                                            <span t-field="b.remaining_amount" t-options='{"widget": "monetary", "display_currency": b.currency_id}'/>
                                        </td>
                                        <td class="text-center pe-3">
                                            <span t-if="b.state == 'confirmed'" class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3 py-1">
                                                Terkonfirmasi
                                            </span>
                                            <span t-elif="b.state == 'waiting_payment'" class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-1">
                                                Menunggu Pembayaran
                                            </span>
                                            <span t-elif="b.state == 'canceled'" class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-3 py-1">
                                                Dibatalkan
                                            </span>
                                            <span t-else="" class="badge rounded-pill bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-1">
                                                Draf
                                            </span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div t-if="pager" class="o_portal_pager d-flex justify-content-center mt-4">
                    <t t-call="portal.pager"/>
                </div>
            </t>
        </t>
    </template>

    <!-- 4. Portal Booking Detail View: Rincian Pemesanan, Unit & Jadwal Cicilan -->
    <template id="portal_my_booking_detail" name="Rincian Reservasi Properti">
        <t t-call="portal.portal_layout">
            <div class="row mt-3 mb-4">
                <div class="col-12">
                    <!-- Header Informasi Dokumen -->
                    <div class="card border-0 shadow-sm rounded-3 mb-4">
                        <div class="card-body p-4">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                                <div>
                                    <span class="text-muted small text-uppercase fw-semibold">Dokumen Reservasi</span>
                                    <h2 class="fw-bold text-dark mb-1"><t t-esc="booking.name"/></h2>
                                    <p class="text-muted mb-0">
                                        Tanggal Transaksi: <span class="fw-medium text-dark" t-field="booking.booking_date" t-options='{"widget": "date"}'/>
                                    </p>
                                </div>
                                <div class="text-end">
                                    <span t-if="booking.state == 'confirmed'" class="badge rounded-pill bg-success text-white px-3 py-2 fs-6">
                                        <i class="fa fa-check-circle me-1"/> Terkonfirmasi
                                    </span>
                                    <span t-elif="booking.state == 'waiting_payment'" class="badge rounded-pill bg-warning text-dark px-3 py-2 fs-6">
                                        <i class="fa fa-clock-o me-1"/> Menunggu Pembayaran
                                    </span>
                                    <span t-elif="booking.state == 'canceled'" class="badge rounded-pill bg-danger text-white px-3 py-2 fs-6">
                                        <i class="fa fa-times-circle me-1"/> Dibatalkan
                                    </span>
                                    <span t-else="" class="badge rounded-pill bg-secondary text-white px-3 py-2 fs-6">
                                        <i class="fa fa-pencil me-1"/> Draf
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Ringkasan Unit Properti & Skema Pembiayaan -->
                    <div class="row g-4 mb-4">
                        <!-- Kolom Informasi Properti -->
                        <div class="col-12 col-md-6">
                            <div class="card border-0 shadow-sm rounded-3 h-100">
                                <div class="card-body p-4">
                                    <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom">
                                        <i class="fa fa-building-o text-primary me-2"/> Informasi Unit Properti
                                    </h5>
                                    <dl class="row mb-0 small">
                                        <dt class="col-5 text-muted fw-normal">Nama Unit</dt>
                                        <dd class="col-7 fw-semibold text-dark"><t t-esc="booking.property_id.name"/></dd>

                                        <dt class="col-5 text-muted fw-normal">Tipe Properti</dt>
                                        <dd class="col-7 text-dark">
                                            <t t-if="booking.property_id.property_type_id" t-esc="booking.property_id.property_type_id.name"/>
                                            <t t-else="">-</t>
                                        </dd>

                                        <dt class="col-5 text-muted fw-normal">Kode Pos / Area</dt>
                                        <dd class="col-7 text-dark">
                                            <t t-if="booking.property_id.postcode" t-esc="booking.property_id.postcode"/>
                                            <t t-else="">-</t>
                                        </dd>

                                        <dt class="col-5 text-muted fw-normal">Harga Total Properti</dt>
                                        <dd class="col-7 fw-bold text-primary">
                                            <span t-field="booking.property_id.selling_price" t-options='{"widget": "monetary", "display_currency": booking.currency_id}'/>
                                        </dd>
                                    </dl>
                                </div>
                            </div>
                        </div>

                        <!-- Kolom Rekapitulasi Finansial -->
                        <div class="col-12 col-md-6">
                            <div class="card border-0 shadow-sm rounded-3 h-100">
                                <div class="card-body p-4">
                                    <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom">
                                        <i class="fa fa-credit-card text-success me-2"/> Rekapitulasi Pembayaran
                                    </h5>
                                    <dl class="row mb-0 small">
                                        <dt class="col-6 text-muted fw-normal">Uang Tanda Jadi Terbayar</dt>
                                        <dd class="col-6 text-end fw-semibold text-success">
                                            <span t-field="booking.booking_fee_paid" t-options='{"widget": "monetary", "display_currency": booking.currency_id}'/>
                                        </dd>

                                        <dt class="col-6 text-muted fw-normal">Durasi Termin Cicilan</dt>
                                        <dd class="col-6 text-end fw-semibold text-dark">
                                            <t t-esc="booking.installment_term"/> Bulan
                                        </dd>

                                        <dt class="col-6 text-muted fw-normal">Sisa Kewajiban Pembayaran</dt>
                                        <dd class="col-6 text-end fw-bold text-danger">
                                            <span t-field="booking.remaining_amount" t-options='{"widget": "monetary", "display_currency": booking.currency_id}'/>
                                        </dd>
                                    </dl>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tabel Jadwal Termin Cicilan (estate.installment) -->
                    <div class="card border-0 shadow-sm rounded-3">
                        <div class="card-header bg-white border-bottom p-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h5 class="fw-bold text-dark mb-1">
                                        <i class="fa fa-calendar-check-o text-info me-2"/> Jadwal Termin Cicilan
                                    </h5>
                                    <p class="text-muted small mb-0">
                                        Pantau status penagihan dan lakukan pembayaran faktur secara mandiri.
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            <t t-if="not booking.installment_ids">
                                <div class="text-center text-muted py-5">
                                    <i class="fa fa-calendar-o fa-2x mb-2 text-secondary"/>
                                    <p class="mb-0">Jadwal termin cicilan belum diterbitkan untuk reservasi ini.</p>
                                </div>
                            </t>
                            <t t-if="booking.installment_ids">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light text-uppercase small text-muted">
                                            <tr>
                                                <th class="ps-4">Keterangan Termin</th>
                                                <th>Jatuh Tempo</th>
                                                <th class="text-end">Nilai Tagihan</th>
                                                <th class="text-center">Status Pelunasan</th>
                                                <th class="text-end pe-4">Dokumen Faktur &amp; Pembayaran</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="booking.installment_ids" t-as="inst">
                                                <tr>
                                                    <td class="ps-4 py-3 fw-semibold text-dark">
                                                        <t t-esc="inst.name"/>
                                                    </td>
                                                    <td class="text-muted">
                                                        <span t-field="inst.due_date" t-options='{"widget": "date"}'/>
                                                    </td>
                                                    <td class="text-end fw-bold text-dark">
                                                        <span t-field="inst.amount" t-options='{"widget": "monetary", "display_currency": inst.currency_id}'/>
                                                    </td>
                                                    <td class="text-center">
                                                        <span t-if="inst.state == 'paid'" class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3 py-1">
                                                            <i class="fa fa-check me-1"/> Lunas
                                                        </span>
                                                        <span t-elif="inst.state == 'late'" class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-3 py-1">
                                                            <i class="fa fa-exclamation-triangle me-1"/> Terlambat
                                                        </span>
                                                        <span t-else="" class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-1">
                                                            <i class="fa fa-clock-o me-1"/> Belum Lunas
                                                        </span>
                                                    </td>
                                                    <td class="text-end pe-4">
                                                        <t t-if="inst.invoice_id">
                                                            <a t-attf-href="/my/invoices/#{inst.invoice_id.id}" class="btn btn-sm btn-outline-primary fw-medium rounded-pill px-3 shadow-sm">
                                                                <i class="fa fa-file-text-o me-1"/>
                                                                <t t-esc="inst.invoice_id.name or 'Lihat Faktur'"/>
                                                            </a>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="badge text-bg-light border text-muted small px-2 py-1">
                                                                <i class="fa fa-hourglass-start me-1"/> Draf Administrasi
                                                            </span>
                                                        </t>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
