<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action Window: estate.installment -->
    <record id="estate_installment_action" model="ir.actions.act_window">
        <field name="name">Jadwal Cicilan</field>
        <field name="res_model">estate.installment</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada jadwal cicilan pembiayaan.
            </p>
            <p>
                Daftar jadwal termin cicilan yang terhubung dengan dokumen reservasi properti akan muncul di sini.
            </p>
        </field>
    </record>

    <!-- Search View: estate.installment -->
    <record id="estate_installment_view_search" model="ir.ui.view">
        <field name="name">estate.installment.search</field>
        <field name="model">estate.installment</field>
        <field name="arch" type="xml">
            <search string="Cari Jadwal Cicilan">
                <field name="name" string="Keterangan" />
                <field name="booking_id" string="Reservasi" />
                <filter name="filter_unpaid" string="Belum Lunas" domain="[('state', '=', 'unpaid')]" />
                <filter name="filter_paid" string="Lunas" domain="[('state', '=', 'paid')]" />
                <filter name="filter_late" string="Terlambat" domain="[('state', '=', 'late')]" />
                <group expand="0" string="Kelompokkan Berdasarkan">
                    <filter name="group_by_booking" string="Reservasi" context="{'group_by': 'booking_id'}" />
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}" />
                    <filter name="group_by_due_date" string="Tanggal Jatuh Tempo" context="{'group_by': 'due_date'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Tree/List View: estate.installment -->
    <record id="estate_installment_view_tree" model="ir.ui.view">
        <field name="name">estate.installment.tree</field>
        <field name="model">estate.installment</field>
        <field name="arch" type="xml">
            <tree string="Daftar Jadwal Cicilan">
                <field name="booking_id" />
                <field name="name" />
                <field name="due_date" />
                <field name="currency_id" column_invisible="True" />
                <field name="amount" widget="monetary" />
                <field name="invoice_id" />
                <field name="state" widget="badge"
                    decoration-danger="state == 'late'"
                    decoration-success="state == 'paid'"
                    decoration-warning="state == 'unpaid'" />
            </tree>
        </field>
    </record>

    <!-- Form View: estate.installment -->
    <record id="estate_installment_view_form" model="ir.ui.view">
        <field name="name">estate.installment.form</field>
        <field name="model">estate.installment</field>
        <field name="arch" type="xml">
            <form string="Jadwal Cicilan">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Contoh: Cicilan Bulan 1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="booking_id" />
                            <field name="due_date" />
                        </group>
                        <group>
                            <field name="currency_id" invisible="1" />
                            <field name="amount" widget="monetary" />
                            <field name="invoice_id" />
                            <field name="state" widget="badge"
                                decoration-danger="state == 'late'"
                                decoration-success="state == 'paid'"
                                decoration-warning="state == 'unpaid'" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
