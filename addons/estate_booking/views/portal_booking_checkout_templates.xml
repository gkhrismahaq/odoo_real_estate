<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Template: Formulir Checkout Pemesanan Properti -->
    <template id="booking_checkout" name="Checkout Pemesanan Properti">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty py-4">
                <div class="container">

                    <!-- Breadcrumb Navigasi Minimalis -->
                    <nav aria-label="breadcrumb" class="mb-4">
                        <ol class="breadcrumb bg-transparent p-0 mb-0 small text-muted">
                            <li class="breadcrumb-item">
                                <a href="/" class="text-decoration-none text-muted">Beranda</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="/properties" class="text-decoration-none text-muted">Katalog Properti</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a t-attf-href="/property/#{property.id}" class="text-decoration-none text-muted">
                                    <t t-esc="property.name" />
                                </a>
                            </li>
                            <li class="breadcrumb-item active text-dark" aria-current="page">
                                Checkout Pemesanan
                            </li>
                        </ol>
                    </nav>

                    <!-- Layout 2 Kolom: Form Pemesan & Ringkasan Properti -->
                    <div class="row g-5">

                        <!-- Kolom Kiri: Formulir Data Pemesan -->
                        <div class="col-12 col-lg-7">
                            <div class="mb-4 pb-3 border-bottom">
                                <h1 class="fw-semibold text-dark h2 mb-1">
                                    Formulir Pemesanan Unit
                                </h1>
                                <p class="text-muted small mb-0">
                                    Lengkapi informasi identitas Anda untuk mengunci unit dan menerbitkan dokumen reservasi.
                                </p>
                            </div>

                            <!-- Pesan Peringatan Galat Validasi -->
                            <div class="alert alert-danger py-2 small mb-4" role="alert" t-if="error">
                                <i class="fa fa-exclamation-circle me-1" />
                                <t t-esc="error" />
                            </div>

                            <!-- Form Checkout -->
                            <form action="/booking/checkout/submit" method="post" class="mt-3">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                                <input type="hidden" name="property_id" t-att-value="property.id" />

                                <div class="mb-3">
                                    <label for="name" class="form-label small fw-semibold text-muted">
                                        Nama Lengkap <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" name="name" id="name" required="required"
                                           class="form-control rounded-2"
                                           placeholder="Masukkan nama lengkap sesuai KTP"
                                           t-att-value="default_name" />
                                </div>

                                <div class="mb-3">
                                    <label for="email" class="form-label small fw-semibold text-muted">
                                        Alamat Email <span class="text-danger">*</span>
                                    </label>
                                    <input type="email" name="email" id="email" required="required"
                                           class="form-control rounded-2"
                                           placeholder="nama@email.com"
                                           t-att-value="default_email" />
                                    <div class="form-text small text-muted">
                                        Bukti reservasi dan rincian transaksi akan dikirimkan ke email ini.
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label for="phone" class="form-label small fw-semibold text-muted">
                                        Nomor Telepon / WhatsApp
                                    </label>
                                    <input type="tel" name="phone" id="phone"
                                           class="form-control rounded-2"
                                           placeholder="+62 812-xxxx-xxxx"
                                           t-att-value="default_phone" />
                                </div>

                                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold rounded-2 shadow-sm mb-3">
                                    Konfirmasi &amp; Lanjutkan Pemesanan
                                </button>

                                <div class="text-center">
                                    <a t-attf-href="/property/#{property.id}" class="text-decoration-none small text-muted">
                                        ← Kembali ke Detail Properti
                                    </a>
                                </div>
                            </form>
                        </div>

                        <!-- Kolom Kanan: Ringkasan Unit Properti -->
                        <div class="col-12 col-lg-5">
                            <div class="card border rounded-3 shadow-sm sticky-top" style="top: 2rem;">
                                <div class="card-body p-4">
                                    <h5 class="fw-semibold text-dark mb-3">Ringkasan Unit</h5>

                                    <div class="mb-3 pb-3 border-bottom">
                                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                            <span t-if="property.property_type_id" class="badge rounded-pill bg-light text-dark border">
                                                <t t-esc="property.property_type_id.name" />
                                            </span>
                                            <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle">
                                                Tersedia
                                            </span>
                                        </div>
                                        <h4 class="fw-bold text-dark mb-1">
                                            <t t-esc="property.name" />
                                        </h4>
                                        <div class="text-muted small" t-if="property.postcode">
                                            <i class="fa fa-map-marker me-1" />
                                            Kode Pos: <span class="text-dark fw-medium" t-esc="property.postcode" />
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="text-muted small">Harga Penawaran:</span>
                                            <span class="text-dark fw-semibold"
                                                  t-out="property.expected_price"
                                                  t-options="{'widget': 'monetary', 'display_currency': website.company_id.currency_id}" />
                                        </div>
                                    </div>

                                    <div class="p-3 rounded-2 bg-light border mb-3">
                                        <div class="d-flex justify-content-between align-items-baseline mb-1">
                                            <span class="text-muted small fw-semibold">Uang Tanda Jadi:</span>
                                            <span class="fs-5 fw-bold text-primary"
                                                  t-out="property.booking_fee"
                                                  t-options="{'widget': 'monetary', 'display_currency': website.company_id.currency_id}" />
                                        </div>
                                        <div class="text-muted small" style="font-size: 0.85rem;">
                                            Biaya awal untuk mengunci unit ini sebelum masuk ke tahapan akad.
                                        </div>
                                    </div>

                                    <div class="text-muted small" style="font-size: 0.825rem;">
                                        <i class="fa fa-info-circle text-primary me-1" />
                                        Dokumen reservasi akan dibuat secara otomatis dengan nomor referensi unik setelah form dikonfirmasi.
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Template: Konfirmasi Reservasi Sukses -->
    <template id="booking_confirmation" name="Konfirmasi Reservasi Properti">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty py-5">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-12 col-md-8 col-lg-7">

                            <!-- Kartu Status Konfirmasi -->
                            <div class="card border rounded-3 shadow-sm p-4 p-md-5 text-center mb-4">
                                <div class="text-success mb-3">
                                    <i class="fa fa-check-circle-o fa-4x" />
                                </div>
                                <h2 class="fw-semibold text-dark mb-2">
                                    Reservasi Berhasil Diterbitkan
                                </h2>
                                <p class="text-muted small mb-4">
                                    Dokumen pemesanan Anda telah terdaftar dalam status Draft di sistem Estate Booking.
                                </p>

                                <div class="d-inline-flex flex-wrap align-items-center justify-content-center gap-2 p-2 px-3 bg-light rounded-pill border mx-auto mb-4">
                                    <span class="text-muted small">Nomor Referensi:</span>
                                    <span class="fw-bold text-dark font-monospace">
                                        <t t-esc="booking.name" />
                                    </span>
                                </div>

                                <!-- Rincian Pemesanan -->
                                <div class="text-start border-top pt-4 mb-4">
                                    <h6 class="fw-bold text-dark mb-3">Rincian Dokumen Pemesanan</h6>
                                    <table class="table table-borderless table-sm small align-middle mb-0">
                                        <tbody>
                                            <tr class="border-bottom">
                                                <td class="text-muted py-2 w-50">Unit Properti</td>
                                                <td class="text-dark fw-semibold py-2">
                                                    <t t-esc="property.name" />
                                                </td>
                                            </tr>
                                            <tr class="border-bottom">
                                                <td class="text-muted py-2">Nama Pemesan</td>
                                                <td class="text-dark fw-semibold py-2">
                                                    <t t-esc="booking.customer_id.name" />
                                                </td>
                                            </tr>
                                            <tr class="border-bottom">
                                                <td class="text-muted py-2">Alamat Email</td>
                                                <td class="text-dark fw-semibold py-2">
                                                    <t t-esc="booking.customer_id.email" />
                                                </td>
                                            </tr>
                                            <tr class="border-bottom" t-if="booking.customer_id.phone">
                                                <td class="text-muted py-2">Nomor Telepon</td>
                                                <td class="text-dark fw-semibold py-2">
                                                    <t t-esc="booking.customer_id.phone" />
                                                </td>
                                            </tr>
                                            <tr class="border-bottom">
                                                <td class="text-muted py-2">Tanggal Pemesanan</td>
                                                <td class="text-dark fw-semibold py-2">
                                                    <span t-field="booking.booking_date" t-options="{'widget': 'date'}" />
                                                </td>
                                            </tr>
                                            <tr>
                                                <td class="text-muted py-2">Tagihan Uang Tanda Jadi</td>
                                                <td class="text-primary fw-bold fs-6 py-2">
                                                    <span t-out="booking.booking_fee_paid"
                                                          t-options="{'widget': 'monetary', 'display_currency': booking.currency_id}" />
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                <div class="p-3 rounded-2 bg-light border text-start small mb-4">
                                    <div class="fw-semibold text-dark mb-1">
                                        <i class="fa fa-info-circle text-primary me-1" /> Langkah Selanjutnya
                                    </div>
                                    <div class="text-muted">
                                        Silakan lanjutkan pembayaran tanda jadi untuk mengonfirmasi pemesanan dan mengamankan status kepemilikan unit Anda.
                                    </div>
                                </div>

                                <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                                    <a href="/properties" class="btn btn-outline-secondary px-4 py-2 rounded-2">
                                        Kembali ke Katalog
                                    </a>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
